      "problemTypes": [
        {
          "descriptions": [
            {
              "cweId": "CWE-311",
              "description": "CWE-311: Missing Encryption of Sensitive Data - Audio adaptation sets in the MPEG-DASH manifest ContentProtection descriptor are not marked for CENC encryption, causing audio segments to be delivered as cleartext fMP4 containers.",
              "lang": "en",
              "type": "CWE"
            }
          ]
        },
        {
          "descriptions": [
            {
              "cweId": "CWE-693",
              "description": "CWE-693: Protection Mechanism Failure - Widevine DRM is enforced for video tracks but the protection mechanism is not applied to audio tracks, creating an asymmetric content protection policy.",
              "lang": "en",
              "type": "CWE"
            }
          ]
        },
        {
          "descriptions": [
            {
              "cweId": "CWE-319",
              "description": "CWE-319: Cleartext Transmission of Sensitive Information - Audio segment payloads are transmitted as cleartext over CDN delivery without encryption at the content layer.",
              "lang": "en",
              "type": "CWE"
            }
          ]
        }
      ],
